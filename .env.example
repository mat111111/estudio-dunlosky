# Copiá este archivo como ".env" si querés cambiar algo. Todo es opcional.

# Puerto en el que se abre la app (http://localhost:8000)
PUERTO=8000

# Zona horaria para el calendario de repasos
TZ=America/Argentina/Buenos_Aires

# Cuentas: 1 = pide usuario y contraseña (recomendado). 0 = sin login (solo uso local)
AUTH=1
# 0 = nadie más puede crear cuentas (la primera siempre se puede crear)
ALLOW_SIGNUP=1

# Modo IA opcional: corrige respuestas abiertas por significado y suma preguntas.
# También se puede configurar desde la pantalla Ajustes de la app.
# Proveedor: anthropic (Claude) o gemini (Google)
AI_PROVIDER=

# Claude: clave de https://platform.claude.com (API Keys)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5

# Gemini: clave de https://aistudio.google.com/apikey (proyecto con facturación)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Buscador de toda la web (SearXNG). docker-compose lo levanta solo; no hace falta tocar nada.
# Para no usarlo: SEARXNG_URL=no
# SEARXNG_SECRET=una-clave-larga-cualquiera

# Exa: buscador web por significado (US$10 de crédito gratis por mes, sin tarjeta): https://exa.ai
EXA_API_KEY=

# Buscadores opcionales (también se cargan en Ajustes)
# YouTube Data API v3 (videos recomendados, 100 búsquedas gratis por día):
# https://console.cloud.google.com/apis/library/youtube.googleapis.com
GOOGLE_API_KEY=
# Serper: Google, Google Académico y videos (2.500 búsquedas gratis al registrarte): https://serper.dev
SERPER_API_KEY=
# SerpApi: Google, Google Académico y YouTube (250 búsquedas gratis por mes): https://serpapi.com
SERPAPI_API_KEY=
# Tavily: https://app.tavily.com (1.000 búsquedas gratis por mes)
TAVILY_API_KEY=
# Brave Search: https://brave.com/search/api/
BRAVE_API_KEY=
# OpenAlex (opcional, aumenta el límite diario): https://openalex.org/settings/api
OPENALEX_API_KEY=
