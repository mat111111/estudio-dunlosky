# Copiá este archivo como ".env" si querés cambiar algo. Todo es opcional.

# Puerto en el que se abre la app (http://localhost:8000)
PUERTO=8000

# Zona horaria para el calendario de repasos
TZ=America/Argentina/Buenos_Aires

# Modo IA opcional: corrige respuestas abiertas por significado y suma preguntas.
# También se puede cargar desde la pantalla Ajustes de la app.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
